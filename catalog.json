  "cli_options": [
    {
      "name": "--accession",
      "help": "A single NCBI assembly accession to download (e.g. GCF_000005845.2)."
    },
    {
      "name": "--accessions",
      "help": "Path to a file of accessions, one per line."
    },
    {
      "name": "--species",
      "help": "A species (or any taxon) name to download assemblies for."
    },
    {
      "name": "--section",
      "default": "refseq",
      "type": "click.Choice(['refseq', 'genbank', 'all'], case_sensitive=False)",
      "help": "Assembly source to query for --species."
    },
    {
      "name": "--assembly-level",
      "default": "all",
      "help": "Comma-separated assembly levels for --species (complete,chromosome,scaffold,contig or all)."
    },
    {
      "name": "--formats",
      "default": "fasta",
      "help": "Comma-separated formats to download (fasta,genbank,gff,gtf,protein,cds,rna,feature-table,assembly-report,assembly-stats or all)."
    },
    {
      "name": "--limit",
      "default": 10,
      "type": "int",
      "help": "Max assemblies to download for --species (0 = no limit)."
    },
    {
      "name": "--seed",
      "default": 42,
      "type": "int",
      "help": "Random seed for reproducible --species subsetting."
    },
    {
      "name": "--max-attempts",
      "short": "-m",
      "default": 3,
      "type": "int",
      "help": "Maximum number of download attempts."
    },
    {
      "name": "--sleep",
      "short": "-s",
      "default": 10,
      "type": "int",
      "help": "Seconds to sleep between download retries."
    },
    {
      "name": "--force",
      "short": "-F",
      "is_flag": true,
      "help": "Overwrite existing files."
    },
    {
      "name": "--ignore",
      "short": "-I",
      "is_flag": true,
      "help": "Skip MD5 validation of downloaded files."
    },
    {
      "name": "--outdir",
      "short": "-o",
      "default": "./",
      "help": "Directory to write downloads to."
    },
    {
      "name": "--prefix",
      "default": "genome-dl",
      "help": "Prefix for the metadata TSV file."
    },
    {
      "name": "--cpus",
      "default": 3,
      "type": "int",
      "help": "Number of concurrent downloads."
    },
    {
      "name": "--json",
      "is_flag": true,
      "help": "Emit the run report as compact JSON to stdout for piping into other tools."
    },
    {
      "name": "--dry-run",
      "is_flag": true,
      "help": "List assemblies without downloading."
    },
    {
      "name": "--progress",
      "is_flag": true,
      "help": "Show per-file download progress."
    },
    {
      "name": "--silent",
      "is_flag": true,
      "help": "Only critical errors will be printed."
    },
    {
      "name": "--verbose",
      "short": "-v",
      "is_flag": true,
      "help": "Print debug related text."
    }
